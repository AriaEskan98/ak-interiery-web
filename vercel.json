{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/contact",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/pages/kontakt",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/pages/about",
      "destination": "/o-nas",
      "permanent": true
    },
    {
      "source": "/pages/about-us",
      "destination": "/o-nas",
      "permanent": true
    },
    {
      "source": "/pages/o-nas",
      "destination": "/o-nas",
      "permanent": true
    },
    {
      "source": "/pages/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/collections",
      "destination": "/realizace",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "/realizace",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "/realizace",
      "permanent": true
    },
    {
      "source": "/policies/privacy-policy",
      "destination": "/ochrana-osobnich-udaju",
      "permanent": true
    },
    {
      "source": "/policies/terms-of-service",
      "destination": "/podminky-pouziti",
      "permanent": true
    },
    {
      "source": "/policies/:path*",
      "destination": "/ochrana-osobnich-udaju",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/account/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cs/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
