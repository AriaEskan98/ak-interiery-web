# Copy this file to ".env" and fill it in. Then run:  npm run test:email
PORT=3001

# ── E-mail for enquiries ────────────────────────────────────────────
# Where new enquiries are sent:
MAIL_TO=info@akinteriery.com
# Sender shown in the e-mails (usually the same mailbox as SMTP_USER):
MAIL_FROM="AK Interiéry <info@akinteriery.cz>"
# Send an automatic confirmation to the customer (true/false):
CONFIRM_TO_CUSTOMER=true

# SMTP login of the mailbox that sends the e-mails:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Common settings (use the full e-mail address as SMTP_USER):
#   Seznam.cz / Email.cz ...... SMTP_HOST=smtp.seznam.cz       SMTP_PORT=465
#   Gmail / Google Workspace .. SMTP_HOST=smtp.gmail.com       SMTP_PORT=465   (needs an App Password, not your normal password)
#   Microsoft 365 / Outlook ... SMTP_HOST=smtp.office365.com   SMTP_PORT=587
#   Wedos ..................... SMTP_HOST=wes1-smtp.wedos.net  SMTP_PORT=465
#   Forpsi .................... SMTP_HOST=smtp.forpsi.com      SMTP_PORT=465
# Your hosting/e-mail provider's help pages list the exact values if yours is not here.
